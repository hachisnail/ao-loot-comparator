---
// src/pages/ledger.astro
import MainLayout from "../layouts/MainLayout.astro";
import DiscordLedger from "../components/DiscordLedger.jsx";
---

<MainLayout 
    title="Discord Webhook Ledger | AO Loot Logs" 
    description="Convert raw deposit/withdrawal logs into a clean Discord Markdown ledger via Webhooks."
>
	<div class="max-w-4xl mx-auto px-4 py-10 w-full flex flex-col gap-6">
		
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-stone-800 pb-4 mb-4">
			<div>
				<h1 class="text-2xl font-bold text-stone-100 uppercase tracking-widest flex items-center gap-3">
                    <span class="text-[#5865f2]">///</span> Webhook Ledger
                </h1>
				<p class="text-stone-500 mt-2 text-sm tracking-wide uppercase leading-relaxed max-w-2xl">
					Paste your raw deposit and withdrawal logs below. This tool will mathematically calculate the Net totals and push a formatted Markdown table directly to your Discord server.
				</p>
			</div>
		</div>

        <DiscordLedger client:load />

	</div>
</MainLayout>